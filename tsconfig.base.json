{
  "compilerOptions": {
    "sourceMap": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "composite": true,
    "isolatedModules": true,
    "declarationMap": true,
    "customConditions": ["@portfolio/source"]
  }
}
