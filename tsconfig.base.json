{
  "compilerOptions": {
    "sourceMap": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "composite": true,
    "isolatedModules": true,
    "declarationMap": true,
    "customConditions": ["@portfolio/source"],
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "rootDir": ".",
    "paths": {
      "@portfolio/react-reference": ["./packages/react-reference/src/index.ts"],
      "@portfolio/common-shadcn": ["./packages/common/shadcn/src/index.ts"],
      "@portfolio/portfolio-api": [
        "./packages/portfolio-api/backend/src/index.ts"
      ],
      "@portfolio/portfolio-data": ["./packages/portfolio-data/src/index.ts"],
      "@portfolio/common-scripts": ["./packages/common/scripts/src/index.ts"]
    }
  }
}
