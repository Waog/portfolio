{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUndeclaredDependencies": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out-tsc",
      "!**/test-output",
      "!**/rolldown.config.*.*js",
      "!**/node_modules",
      "!**/.nx",
      "!**/.venv",
      "!**/.grit",
      "!**/*.css",
      "!**/*.gen.*",
      "!**/generated/**",
      "!**/tsconfig*.json"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "**/*.{spec,test}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/*.stories.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    }
  ]
}
