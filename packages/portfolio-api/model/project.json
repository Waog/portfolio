{
  "name": "@portfolio/portfolio-api-model",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/portfolio-api/model/src",
  "projectType": "library",
  "metadata": {
    "generator": "smithy#project",
    "smithyType": "service",
    "namespace": "com.oliverstadie.portfolio",
    "apiName": "portfolio-api-model",
    "backendProject": "@portfolio/portfolio-api"
  },
  "targets": {
    "build": {
      "dependsOn": ["compile", "generate-ssdk"]
    },
    "assemble": {
      "dependsOn": ["compile", "generate-ssdk"]
    },
    "compile": {
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}/smithy",
        "{workspaceRoot}/dist/{projectRoot}/build/openapi"
      ],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "shx rm -rf dist/{projectRoot}/build",
          "shx rm -rf dist/{projectRoot}/smithy",
          "shx mkdir -p dist/{projectRoot}/build",
          "npx -y mise@2026.10.1 exec smithy@1.74.0 -- smithy build -c {projectRoot}/smithy-build.json --output dist/{projectRoot}/smithy",
          "shx mkdir -p dist/{projectRoot}/build/openapi",
          "shx cp \"dist/{projectRoot}/smithy/source/openapi/*.openapi.json\" dist/{projectRoot}/build/openapi/openapi.json"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "generate-ssdk": {
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/build/ssdk"],
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "options": {
        "commands": [
          "npm install --prefix dist/{projectRoot}/smithy/source/typescript-ssdk-codegen --include=dev --ignore-scripts --no-audit --no-fund",
          "rolldown -c {projectRoot}/ssdk.rolldown.config.mjs"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
