{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "./out-tsc/app",
    "types": [],
    "composite": false,
    "declaration": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    "lib": ["dom", "es2022"],
    "rootDir": "../.."
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts", "../../libs/*/*/src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts",
    "**/*.stories.ts",
    "**/*.stories.js",
    "../../libs/**/*.spec.ts",
    "../../libs/**/*.test.ts",
    "../../libs/**/*.stories.ts",
    "../../libs/**/test-setup.ts"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    },
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "references": [
    {
      "path": "../../libs/feature/web-metadata/tsconfig.lib.json"
    },
    {
      "path": "../../libs/util/shared-styles/tsconfig.lib.json"
    },
    {
      "path": "../../libs/feature/page-legal/tsconfig.lib.json"
    },
    {
      "path": "../../libs/feature/page-home/tsconfig.lib.json"
    },
    {
      "path": "../../libs/feature/navigation/tsconfig.lib.json"
    },
    {
      "path": "../../libs/feature/footer/tsconfig.lib.json"
    },
    {
      "path": "../../libs/data-access/customization-state/tsconfig.lib.json"
    }
  ]
}
